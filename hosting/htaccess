# OperumData Parceiros — configuração para hospedagem Apache (HostGator / cPanel)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# Sempre HTTPS (ative o SSL gratuito no cPanel antes de subir)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Tipos de arquivo
AddType font/otf .otf
AddType image/svg+xml .svg

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml font/otf
</IfModule>

# Cache: páginas sempre atualizadas, arquivos estáticos por 30 dias
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# Segurança básica
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
